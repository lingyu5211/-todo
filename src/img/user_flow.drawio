<mxfile host="app.diagrams.net" agent="5.0.1">
  <diagram id="diagram1" name="待办日程管理系统 - 用户流程图">
    <mxGraphModel dx="600" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" parent="1" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1">
          <mxGeometry x="400" y="30" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="login" parent="1" value="用户登录/注册" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="110" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="home" parent="1" value="首页-待办事项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="190" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="todo_action" parent="1" value="待办操作&lt;br&gt;添加/编辑/删除/完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1">
          <mxGeometry x="50" y="280" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="todoset" parent="1" value="待办集管理&lt;br&gt;创建/切换待办列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1">
          <mxGeometry x="260" y="280" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="schedule" parent="1" value="日程管理&lt;br&gt;查看日历/添加日程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="380" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="discipline" parent="1" value="自律打卡&lt;br&gt;专注计时器/番茄钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="460" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="stats" parent="1" value="数据统计&lt;br&gt;查看完成率/历史记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="540" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="profile" parent="1" value="个人中心&lt;br&gt;设置/退出登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1">
          <mxGeometry x="350" y="620" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="decision" parent="1" value="是否继续使用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1">
          <mxGeometry x="360" y="700" width="160" height="80" as="geometry"/>
